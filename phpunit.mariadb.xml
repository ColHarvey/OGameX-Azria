<?xml version="1.0" encoding="UTF-8"?>
<!--
  Les epreuves qui n'ont de sens que sur MariaDB : courses entre processus, portee des verrous,
  rejeu et rollback du reglement sur de vraies transactions. Elles vivent hors des suites de
  phpunit.xml — la suite locale tourne sur SQLite, ou elles seraient ignorees, et l'integration
  continue exige zero ignore. Seul le workflow migrations-mariadb.yml lance cette configuration,
  sur une base jetable.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" bootstrap="tests/bootstrap.php" colors="true" processIsolation="false" stopOnFailure="false" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <testsuites>
    <testsuite name="MariaDB">
      <directory suffix="Test.php">./tests/MariaDb</directory>
      <file>./tests/Feature/Combat/CombatSettlementServiceTest.php</file>
      <file>./tests/Feature/Combat/CombatCancellationTest.php</file>
      <file>./tests/Feature/Combat/FleetDispositionRegistryTest.php</file>
      <file>./tests/Feature/Combat/RefusedFleetHomecomingTest.php</file>
      <file>./tests/Feature/Combat/FleetMovementGateTest.php</file>
      <file>./tests/Feature/Combat/PersistentCombatAdvancerTest.php</file>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="CACHE_DRIVER" value="array"/>
    <env name="CACHE_STORE" value="array"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="QUEUE_DRIVER" value="sync"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
  </php>
</phpunit>
